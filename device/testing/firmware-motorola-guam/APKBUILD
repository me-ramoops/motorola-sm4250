		"$pkgdir/usr/lib/firmware/Himax_firmware.bin"
	install -Dm644 "$srcdir/30-motorola-guam-touchscreen.files" \
		"$pkgdir/usr/share/mkinitfs/files/30-motorola-guam-touchscreen.files"
}

