d8605600e5e93ff0974b699c4ce6b25776f1566c52bde0f4ee0710eac32a6d2d0697ab608df702c6904c1a3e720fc2abb08a69fa6e53bf4ecea314e9fb7a877a  config-nura-qcom-sm61x5.aarch64
